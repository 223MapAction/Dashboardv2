# ─────────────────────────────────────────────────────────────────────────────
# OBLIGATOIRE
# ─────────────────────────────────────────────────────────────────────────────

# Adresse de l'API Map Action dont ce dashboard est le client.
# Aucune valeur par defaut : l'application refuse de demarrer sans elle, pour
# qu'un poste de developpement ne se connecte jamais a la production sans que
# personne ne s'en apercoive. Sert aussi de base aux WebSocket (ws:// ou
# wss:// est deduit automatiquement), il n'y a rien d'autre a configurer.
#
#   instance locale   : http://localhost:8000
#   votre instance    : https://api.exemple.org
VITE_API_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONNEL
# ─────────────────────────────────────────────────────────────────────────────

# Serveur de tuiles OpenStreetMap utilise par le style de carte par defaut.
# Ouvert et auto-hebergeable, ne necessite aucun compte tiers. Plusieurs URLs
# separees par une virgule, avec les gabarits {z}/{x}/{y}. Laisse vide, les
# tuiles publiques openstreetmap.fr sont utilisees.
VITE_OSM_TILE_URLS=https://a.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png,https://b.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png,https://c.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png

# Jeton Mapbox. Active uniquement le style de carte "Satellite", en plus du
# style OpenStreetMap. Sans jeton, la carte fonctionne normalement et le
# bouton "Satellite" n'apparait pas : Mapbox n'est jamais requis.
# Jeton gratuit sur https://account.mapbox.com/
VITE_MAPBOX_TOKEN=
