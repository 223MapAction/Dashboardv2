# Serveur de tuiles OpenStreetMap utilise par la carte (style par defaut,
# ouvert et auto-hebergeable, ne necessite pas de compte tiers). Optionnel :
# plusieurs URLs separees par une virgule, avec les gabarits {z}/{x}/{y}.
# Laisse vide, les tuiles publiques openstreetmap.fr sont utilisees.
VITE_OSM_TILE_URLS=https://a.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png,https://b.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png,https://c.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png

# Mapbox Access Token (entierement optionnel : active uniquement le style
# de carte "Satellite" en plus. Sans token, la carte fonctionne normalement
# avec le style OpenStreetMap ouvert par defaut, et le bouton "Satellite"
# n'apparait pas.)
# Obtenez votre token sur https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_token_here
